# Copier en .env et renseigner. NE PAS committer .env.

# Clé de signature des jetons JWT (générer une longue chaîne aléatoire).
# Ex : openssl rand -hex 32
PRONO_SECRET_KEY=remplace-par-une-cle-aleatoire-longue

# Compte privé unique (le seul autorisé à se connecter).
PRONO_ADMIN_EMAIL=pierreandre.borja@gmail.com
PRONO_ADMIN_PASSWORD=choisis-un-mot-de-passe-fort

# Durée de validité du jeton (minutes). 1440 = 24 h.
PRONO_TOKEN_MINUTES=1440

# Origines autorisées (le front est servi sur le même domaine -> l'URL du site).
PRONO_CORS_ORIGINS=https://ligue1.patrimoineaucarre.com
