# Gabarit d'environnement STAGING. Copier en `.env.staging` SUR LE VPS et y mettre
# des secrets DISTINCTS de la prod (jamais commiter le vrai fichier).
#
# Rappels :
# - la base staging doit etre separee de la prod (identifiants differents ci-dessous) ;
# - les connecteurs externes sont coupes par defaut pour ne pas appeler/ecrire en prod ;
# - le domaine staging est gere par le Caddy PROD via la variable STAGING_SITE_ADDRESS
#   du fichier `.env` de la PROD (pas ici).
APP_NAME=PatrimoineOp API (staging)
APP_VERSION=0.1.0-staging
DATABASE_URL=postgresql+psycopg://patrimoineop_staging:CHANGE_ME@db:5432/patrimoineop_staging
BACKEND_CORS_ORIGINS=https://staging.patrimoineaucarre.com
DGFIP_MAJIC_FILE_PATH=
VITE_API_URL=/api
POSTGRES_DB=patrimoineop_staging
POSTGRES_USER=patrimoineop_staging
POSTGRES_PASSWORD=CHANGE_ME
SITE_ADDRESS=:80
SECRET_KEY=CHANGE_ME_staging_secret_distinct_de_la_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Pronostics — sync coupee en staging
FOOTBALL_DATA_TOKEN=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_COMPETITION=WC
FOOTBALL_DATA_SEASON=2026
PRONOSTICS_SCORE_SYNC_ENABLED=false
PRONOSTICS_SCORE_SYNC_INTERVAL_HOURS=6
PRONOSTICS_APP_URL=https://staging.patrimoineaucarre.com/pronostics
PRONOSTICS_RESET_EXPIRE_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true

# ENEDIS — sync coupee, pas de credentials en staging
ENEDIS_AUTH_URL=https://gw.ext.prod.api.enedis.fr/oauth/v1/token
ENEDIS_BASE_URL=https://gw.ext.prod.api.enedis.fr
ENEDIS_PERIMETER_URL=https://gw.ext.prod.api.enedis.fr/usage_point_id_perimeter/v1/usage_point_id
ENEDIS_CLIENT_ID=
ENEDIS_CLIENT_SECRET=
ENEDIS_HISTORY_DAYS=1095
ENEDIS_CUSTOMER_SYNC_ENABLED=false
ENEDIS_CUSTOMER_SYNC_INTERVAL_HOURS=168

# ENGIE — pas de credentials en staging
ENGIE_BASE_URL=https://api.entreprises-collectivites.engie.fr/ec/v1
ENGIE_SUBSCRIPTION_KEY=
