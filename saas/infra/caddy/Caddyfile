{$SITE_ADDRESS} {
    handle_path /pronostics* {
        reverse_proxy pronostics:80
    }

    handle /api/auth/register {
        route {
            forward_auth backend:8000 {
                uri /api/internal/basic-auth
            }
            reverse_proxy backend:8000
        }
    }

    handle /api/internal/* {
        respond 404
    }

    handle /api/* {
        reverse_proxy backend:8000 {
            transport http {
                # Les endpoints IGN/MAJIC font des appels WFS exterieurs qui
                # peuvent prendre jusqu'a 60s. On passe le timeout a 120s
                # pour eviter les 502 dus a un proxy timeout trop court.
                response_header_timeout 120s
            }
        }
    }

    handle {
        route {
            forward_auth backend:8000 {
                uri /api/internal/basic-auth
            }
            reverse_proxy frontend:80
        }
    }
}
