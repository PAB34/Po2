{$SITE_ADDRESS} {
    handle /pronostics* {
        redir {$PRONOSTICS_URL:https://script.google.com/macros/s/AKfycbw7hAKTCLS_Ew5cpRsQ6i7q26LWYSZ9EZ3PO-NM1_UOWjhaczphv6aiGaXRD1uyvufkpQ/exec} 302
    }

    handle /api/auth/register {
        basic_auth {
            {$ADMIN_BASIC_AUTH_USER:disabled} {$ADMIN_BASIC_AUTH_PASSWORD_HASH:$2a$14$Zkx19XLiW6VYouLHR5NmfOFU0z2GTNmpkT/5qqR7hx4IjWJPDhjvH}
        }
        reverse_proxy backend:8000
    }

    handle /api/* {
        reverse_proxy backend:8000 {
            transport http {
                # Les endpoints IGN/MAJIC font des appels WFS exterieurs qui
                # peuvent prendre jusqu'a 60s. On passe le timeout a 120s
                # pour eviter les 502 dus a un proxy timeout trop court.
                response_header_timeout 120s
            }
        }
    }

    handle {
        basic_auth {
            {$ADMIN_BASIC_AUTH_USER:disabled} {$ADMIN_BASIC_AUTH_PASSWORD_HASH:$2a$14$Zkx19XLiW6VYouLHR5NmfOFU0z2GTNmpkT/5qqR7hx4IjWJPDhjvH}
        }
        reverse_proxy frontend:80
    }
}
