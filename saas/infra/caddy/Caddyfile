{$SITE_ADDRESS} {
    handle_path /pronostics* {
        reverse_proxy pronostics:80
    }

    handle /api/auth/register {
        route {
            forward_auth backend:8000 {
                uri /api/internal/basic-auth
            }
            reverse_proxy backend:8000
        }
    }

    handle /api/internal/* {
        respond 404
    }

    handle /api/* {
        reverse_proxy backend:8000 {
            transport http {
                # Les endpoints IGN/MAJIC font des appels WFS exterieurs qui
                # peuvent prendre jusqu'a 60s. On passe le timeout a 120s
                # pour eviter les 502 dus a un proxy timeout trop court.
                response_header_timeout 120s
            }
        }
    }

    handle {
        route {
            forward_auth backend:8000 {
                uri /api/internal/basic-auth
            }
            reverse_proxy frontend:80
        }
    }
}

# Pre-production (staging) — meme Caddy, sous-domaine distinct, route vers les
# conteneurs du projet `po2-staging` via le reseau partage `po2-edge`.
# Active uniquement quand le DNS staging pointe vers ce VPS (sinon l'emission du
# certificat ACME echoue et reessaie sans impacter la prod).
{$STAGING_SITE_ADDRESS:staging.patrimoineaucarre.com} {
    handle_path /pronostics* {
        reverse_proxy pronostics-staging:80
    }

    handle /api/auth/register {
        route {
            forward_auth backend-staging:8000 {
                uri /api/internal/basic-auth
            }
            reverse_proxy backend-staging:8000
        }
    }

    handle /api/internal/* {
        respond 404
    }

    handle /api/* {
        reverse_proxy backend-staging:8000 {
            transport http {
                response_header_timeout 120s
            }
        }
    }

    handle {
        route {
            forward_auth backend-staging:8000 {
                uri /api/internal/basic-auth
            }
            reverse_proxy frontend-staging:80
        }
    }
}

# =====================================================================
# PRONO — app privée Ligue 1 (sous-domaine dédié).
# Conteneurs prono-frontend / prono-backend sur le réseau partagé po2-edge
# (cf. PRONO/infra/docker-compose.yml). HTTPS auto dès que le DNS pointe ici.
# L'auth est gérée par l'app elle-même (login JWT) : pas de forward_auth ici.
# =====================================================================
ligue1.patrimoineaucarre.com {
    handle /api/* {
        reverse_proxy prono-backend:8000 {
            transport http {
                response_header_timeout 120s
            }
        }
    }

    handle {
        reverse_proxy prono-frontend:80
    }
}
